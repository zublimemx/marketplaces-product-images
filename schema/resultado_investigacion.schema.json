{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resultado_investigacion.schema.json",
  "title": "Resultado de un lote de investigación (inv_XX.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "gtin",
      "titulo",
      "descripcion",
      "categoria_id",
      "categoria_ruta",
      "ficha",
      "receta_mx",
      "categoria_rx_sugerida",
      "catalogo_ml",
      "url_oficial",
      "fuentes",
      "encontrado_por",
      "confianza",
      "notas",
      "notas_imagenes"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "gtin": {
        "type": "string",
        "pattern": "^[0-9]{6,14}$"
      },
      "titulo": {
        "type": "string",
        "maxLength": 60,
        "minLength": 1
      },
      "descripcion": {
        "type": "string",
        "minLength": 100
      },
      "categoria_id": {
        "type": "string",
        "pattern": "^MLM[0-9]+$"
      },
      "categoria_ruta": {
        "type": "string"
      },
      "ficha": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "marca": {
            "type": "string"
          },
          "fabricante": {
            "type": "string"
          },
          "linea": {
            "type": "string"
          },
          "variante": {
            "type": "string"
          },
          "presentacion": {
            "type": "string"
          },
          "contenido_neto": {
            "type": [
              "number",
              "string"
            ]
          },
          "unidad_contenido": {
            "type": "string"
          },
          "unidades_por_envase": {
            "type": [
              "number",
              "string"
            ]
          },
          "principio_activo": {
            "type": "string"
          },
          "concentracion": {
            "type": "string"
          },
          "via_administracion": {
            "type": "string"
          },
          "edad_etapa": {
            "type": "string"
          },
          "talla": {
            "type": "string"
          },
          "sabor_aroma": {
            "type": "string"
          },
          "genero": {
            "type": "string"
          },
          "tipo_piel_cabello": {
            "type": "string"
          },
          "registro_sanitario": {
            "type": "string"
          },
          "otros": {
            "type": "string"
          }
        }
      },
      "receta_mx": {
        "enum": [
          "Sí",
          "No",
          "Revisar",
          "No aplica"
        ]
      },
      "categoria_rx_sugerida": {
        "type": "string",
        "pattern": "^(MLM[0-9]+)?$"
      },
      "catalogo_ml": {
        "type": "string"
      },
      "url_oficial": {
        "type": "string"
      },
      "fuentes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "encontrado_por": {
        "enum": [
          "gtin",
          "nombre",
          "no_encontrado"
        ]
      },
      "confianza": {
        "enum": [
          "alta",
          "media",
          "baja"
        ]
      },
      "notas": {
        "type": "string"
      },
      "notas_imagenes": {
        "type": "string"
      }
    }
  }
}