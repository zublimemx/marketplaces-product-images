# Copia este archivo a .env (ignorado por git) y llena lo que vayas a usar.

# API de Mercado Libre (scripts/meli_precios.py). Crea una aplicación en https://developers.mercadolibre.com.mx
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
# Mejor: python scripts/meli_auth.py --code TG-... --redirect-uri ... guarda access y refresh token en insumos/ml_token.json
# Alternativa temporal: un access token vigente (dura unas 6 horas)
ML_ACCESS_TOKEN=
# Tu seller_id, para excluir tus propias publicaciones del promedio (opcional)
ML_SELLER_ID=

# GitHub (scripts/pr.py), si no usas gh
GH_TOKEN=
